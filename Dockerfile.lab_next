# Используем официальный образ Node.js на Alpine
FROM node:20-alpine AS base

# Устанавливаем системные зависимости: git, wget, tar
RUN apk add --no-cache git wget tar

# Настраиваем Git для корректной работы в монтируемом томе (Windows <-> Linux)
RUN git config --global core.autocrlf input \
    && git config --global core.filemode false \
    && git config --global --list

# Устанавливаем Docker CLI статический бинарник версии 28.0.0 (совместимый с Docker Engine 28.4.0)
RUN wget -q https://download.docker.com/linux/static/stable/x86_64/docker-28.0.0.tgz \
    && tar xzvf docker-28.0.0.tgz --strip-components=1 -C /usr/local/bin docker/docker \
    && rm docker-28.0.0.tgz \
    && docker --version

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей
COPY package.json package-lock.json ./

# Устанавливаем зависимости (включая devDependencies)
RUN npm ci

# Копируем весь исходный код
COPY . .

# Открываем порт, который будет использоваться приложением
EXPOSE 3000

# Команда по умолчанию — запуск dev-сервера
CMD ["npm", "run", "dev"]
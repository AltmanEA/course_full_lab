# Используем официальный образ Playwright, совместимый с версией 1.58.2
FROM mcr.microsoft.com/playwright:v1.58.2-jammy

# Устанавливаем рабочую директорию
WORKDIR /app

# Устанавливаем конкретную версию @playwright/test, совместимую с браузерами в образе
RUN npm install @playwright/test@1.58.2 playwright@1.58.2

# Команда по умолчанию — удерживаем контейнер активным
CMD ["tail", "-f", "/dev/null"]
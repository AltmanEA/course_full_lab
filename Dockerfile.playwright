# Используем официальный образ Playwright, версия 1.58.2 (последняя стабильная)
FROM mcr.microsoft.com/playwright:v1.58.2-jammy

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем package.json и package-lock.json (чтобы зафиксировать версии)
COPY package.json package-lock.json ./

# Устанавливаем только @playwright/test и playwright
# Используем npm install без сохранения в package-lock.json (но lock уже скопирован)
RUN npm install @playwright/test playwright

# Убедимся, что браузеры установлены (опционально, но гарантирует наличие)
RUN npx playwright install

# Копируем весь исходный код (только для чтения)
COPY . .

# Команда по умолчанию — удерживаем контейнер активным
CMD ["tail", "-f", "/dev/null"]